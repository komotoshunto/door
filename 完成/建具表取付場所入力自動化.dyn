    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# IN[0] : Revit要素（単体 or リスト） 例) Select Model Elements\r\n# IN[1] : パラメーター名（表示名 or BuiltInParameter名） 単体でもリストでもOK\r\n# OUT   : (grouped_elements, keys)\r\n#         grouped_elements: 指定パラメータ値の組み合わせごとの要素リスト（ソート済み）\r\n#         keys            : 上記グループのキー（パラメータ値タプル、ソート済み）\r\n\r\nimport clr\r\nimport System\r\n\r\n# Revit API\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import (\r\n    BuiltInParameter, StorageType, ElementId\r\n)\r\n\r\n# RevitServices\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# ---- 入力の正規化 ----\r\ndef to_list(x):\r\n    return x if isinstance(x, list) else [x]\r\n\r\n# DynamoのUnwrapElementはリストにもそのまま使えるが、保険で明示処理\r\ndef unwrap_any(x):\r\n    try:\r\n        return UnwrapElement(x)\r\n    except:\r\n        return x\r\n\r\nraw_elements = IN[0]\r\nelements = to_list(unwrap_any(raw_elements))\r\nparam_names = IN[1]\r\nparam_names = to_list(param_names)\r\n\r\n# ---- ユーティリティ ----\r\n\r\ndef try_get_bip(name):\r\n    \"\"\"\r\n    文字列から BuiltInParameter を取得（存在しなければ None）\r\n    例: \"DOOR_WIDTH\" -> BuiltInParameter.DOOR_WIDTH\r\n    \"\"\"\r\n    try:\r\n        return getattr(BuiltInParameter, name)\r\n    except AttributeError:\r\n        return None\r\n\r\ndef get_type_element(elem):\r\n    \"\"\"\r\n    要素のタイプ要素を返す（タイプ要素自身の場合は None のまま）\r\n    \"\"\"\r\n    try:\r\n        tid = elem.GetTypeId()\r\n        if isinstance(tid, ElementId) and tid.IntegerValue > 0:\r\n            return doc.GetElement(tid)\r\n    except:\r\n        pass\r\n    return None\r\n\r\ndef extract_value(param):\r\n    \"\"\"\r\n    Parameter から値を安全に取り出す\r\n    1) AsValueString（あれば）優先\r\n    2) 型に応じて値を返す\r\n    \"\"\"\r\n    if param is None:\r\n        return \"Param Not Found\"\r\n\r\n    # 表示用文字列（単位付き）を最優先\r\n    try:\r\n        s = param.AsValueString()\r\n        if s is not None:\r\n            return s\r\n    except:\r\n        # 一部の型/状況で例外になることがあるため無視\r\n        pass\r\n\r\n    st = param.StorageType\r\n    if st == StorageType.String:\r\n        sv = param.AsString()\r\n        return sv if sv is not None else \"Null\"\r\n    elif st == StorageType.Integer:\r\n        return param.AsInteger()\r\n    elif st == StorageType.Double:\r\n        # 内部単位のまま（必要ならここで単位変換を追加）\r\n        try:\r\n            return round(param.AsDouble(), 6)\r\n        except:\r\n            return \"Null\"\r\n    elif st == StorageType.ElementId:\r\n        try:\r\n            eid = param.AsElementId()\r\n            if eid and eid.IntegerValue > 0:\r\n                ref_el = doc.GetElement(eid)\r\n                # 参照先があれば名前、なければ数値ID\r\n                return getattr(ref_el, \"Name\", eid.IntegerValue)\r\n            return \"Null\"\r\n        except:\r\n            return \"Null\"\r\n    else:\r\n        return \"Null\"\r\n\r\ndef get_parameter_by_name_or_bip(elem, name_or_bip):\r\n    \"\"\"\r\n    取得順序：\r\n      1) BuiltInParameter名としてインスタンスから get_Parameter\r\n      2) BuiltInParameter名としてタイプから get_Parameter\r\n      3) 表示名としてインスタンスから LookupParameter\r\n      4) 表示名としてタイプから LookupParameter\r\n    見つからなければ \"Param Not Found\"\r\n    \"\"\"\r\n    if elem is None:\r\n        return \"Param Not Found\"\r\n\r\n    # まず BIP 名として試す\r\n    bip = try_get_bip(name_or_bip)\r\n\r\n    # 1) インスタンス + BIP\r\n    if bip is not None:\r\n        try:\r\n            p = elem.get_Parameter(bip)\r\n            if p:\r\n                return extract_value(p)\r\n        except:\r\n            pass\r\n\r\n    # タイプ要素\r\n    typ = get_type_element(elem)\r\n\r\n    # 2) タイプ + BIP\r\n    if bip is not None and typ is not None:\r\n        try:\r\n            p = typ.get_Parameter(bip)\r\n            if p:\r\n                return extract_value(p)\r\n        except:\r\n            pass\r\n\r\n    # 3) インスタンス + 表示名\r\n    try:\r\n        p = elem.LookupParameter(name_or_bip)\r\n        if p:\r\n            return extract_value(p)\r\n    except:\r\n        pass\r\n\r\n    # 4) タイプ + 表示名\r\n    if typ is not None:\r\n        try:\r\n            p = typ.LookupParameter(name_or_bip)\r\n            if p:\r\n                return extract_value(p)\r\n        except:\r\n            pass\r\n\r\n    return \"Param Not Found\"\r\n\r\n# ---- グルーピング ----\r\ngrouped_data = {}  # key(tuple(values)) -> [elements]\r\n\r\nfor e in elements:\r\n    # 入力が Revit API 要素でない場合に備え再度安全にアンラップ\r\n    elem = unwrap_any(e)\r\n    values = []\r\n    for pname in param_names:\r\n        v = get_parameter_by_name_or_bip(elem, pname)\r\n        values.append(v)\r\n    key = tuple(values)\r\n    grouped_data.setdefault(key, []).append(e)  # 元の（ラップされた）要素を返す\r\n\r\n# ---- ソート（キーで昇順） ----\r\ntry:\r\n    sorted_items = sorted(grouped_data.items(), key=lambda x: x[0])\r\nexcept TypeError:\r\n    # 型が混在する場合（数値と文字列など）は文字列化してソート\r\n    sorted_items = sorted(grouped_data.items(), key=lambda x: str(x[0]))\r\n\r\ngrouped_elements = []\r\nkeys = []\r\nfor k, grp in sorted_items:\r\n    grouped_elements.append(grp)\r\n    keys.append(k)\r\n\r\nOUT = grouped_elements, keys\r\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "a0a26fa071c64e2d9cf0a4a28cda413e",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "831386eb33d84d729c73fd8c82f785dd",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "97d05ee71f5d4f63a77de90d25561889",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "f59c4907d51841bcb7f6d9a0c5500473",
          "Name": "OUT",
          "Description": "Python スクリプトの結果",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "埋め込み Python スクリプトを実行します。"
    },
