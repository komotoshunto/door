    {
      "ConcreteType": "CoreNodeModels.Logic.And, CoreNodeModels",
      "VariableInputPorts": true,
      "Id": "d97327f266fb469eb1910646f2fcbdb1",
      "NodeType": "ExtensionNode",
      "Inputs": [
        {
          "Id": "d519cdcc98e744dbaab43080f9c28853",
          "Name": "bool0",
          "Description": "オペランド0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "306ae32321814e7591bfc8466d60e46e",
          "Name": "bool1",
          "Description": "オペランド1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "02cfe787d3b64bb7a35323c837da2799",
          "Name": "bool",
          "Description": "生成された結果ブロック",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Auto",
      "Description": "ブール演算 AND: すべての入力が True の場合にのみ True を返します。いずれかが False の場合は、False を返します。"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Dynamo Python Script（Revit 2024 / Dynamo）\r\nimport clr\r\nclr.AddReference('System')\r\nfrom System.Net import WebClient\r\nfrom System.Text import Encoding, DecoderExceptionFallback, EncoderExceptionFallback\r\n\r\nurl = IN[0]\r\npreferred = None\r\nif len(IN) >= 2 and IN[1]:\r\n    preferred = str(IN[1]).lower().strip()\r\n\r\ndef get_encoding(name_or_codepage):\r\n    try:\r\n        return Encoding.GetEncoding(name_or_codepage)\r\n    except:\r\n        return None\r\n\r\ndef try_decode(data, enc):\r\n    try:\r\n        enc_strict = Encoding.GetEncoding(enc.CodePage,\r\n                                          EncoderExceptionFallback(),\r\n                                          DecoderExceptionFallback())\r\n        return enc_strict.GetString(data)\r\n    except:\r\n        try:\r\n            return enc.GetString(data)\r\n        except:\r\n            return None\r\n\r\ntry:\r\n    client = WebClient()\r\n    raw = client.DownloadData(url)\r\n\r\n    text = None\r\n    # BOM チェック\r\n    if len(raw) >= 3 and raw[0] == 0xEF and raw[1] == 0xBB and raw[2] == 0xBF:\r\n        text = Encoding.UTF8.GetString(raw)                  # UTF-8 BOM\r\n    elif len(raw) >= 2 and raw[0] == 0xFF and raw[1] == 0xFE:\r\n        text = Encoding.Unicode.GetString(raw)               # UTF-16 LE\r\n    elif len(raw) >= 2 and raw[0] == 0xFE and raw[1] == 0xFF:\r\n        text = Encoding.BigEndianUnicode.GetString(raw)      # UTF-16 BE\r\n\r\n    if text is None:\r\n        trial_list = []\r\n        if preferred:\r\n            enc = get_encoding(preferred)\r\n            if enc: trial_list.append(enc)\r\n        for name in [\"utf-8\", \"shift_jis\", \"euc-jp\", \"utf-16\"]:\r\n            enc = get_encoding(name)\r\n            if enc and enc not in trial_list:\r\n                trial_list.append(enc)\r\n        for enc in trial_list:\r\n            decoded = try_decode(raw, enc)\r\n            if decoded is not None:\r\n                text = decoded\r\n                break\r\n\r\n    if text is None:\r\n        OUT = \"Error: 文字コードの自動判定に失敗しました。IN[1] に 'shift_jis' や 'utf-8' などを指定してください。\"\r\n    else:\r\n        OUT = text  # ← 全文の文字列だけを返す\r\n\r\nexcept Exception as e:\r\n    OUT = \"Error: {}\".format(str(e))\r\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "e1c55efb2b3947788fd63b28295d725b",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "43745f3eada746679929a04c30ac58a5",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "62d0de10f2e246e2956959f7b5e1c885",
          "Name": "OUT",
          "Description": "Python スクリプトの結果",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "埋め込み Python スクリプトを実行します。"
    },
