        }
      ],
      "Outputs": [
        {
          "Id": "b38a3bcff09b427ab50392e8b7b2f3e6",
          "Name": "list",
          "Description": "量を指定してフラットにされたリスト",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "FunctionSignature": "DSCore.List.Flatten@var[]..[],int",
      "Replication": "Auto",
      "Description": "ネストされたリストのリストを、指定された量だけフラットにします。\n\nList.Flatten (list: var[]..[], amount: int = -1): var[]..[]"
    },
    {
      "ConcreteType": "Dynamo.Graph.Nodes.ZeroTouch.DSFunction, DynamoCore",
      "Id": "a3a24bfce2844ca59ff8a368708bc872",
      "NodeType": "FunctionNode",
      "Inputs": [
        {
          "Id": "e3c8b4eda25645ff9054d4dc22625520",
          "Name": "list",
          "Description": "フィルタするリスト。\n\nvar[]..[]",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "9c03ca45fd3b4615bd65959c7dbf5187",
          "Name": "mask",
          "Description": "マスクを表すブール値のリスト。\n\nvar[]..[]",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "dfcbdbd02fb34d5c80f96055dd534d09",
          "Name": "in",
          "Description": "マスク インデックスが true の項目。",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "cc0932ebd3ba46f7a9ac24dbfae3580e",
          "Name": "out",
          "Description": "マスク インデックスが false の項目。",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "FunctionSignature": "DSCore.List.FilterByBoolMask@var[]..[],var[]..[]",
      "Replication": "Auto",
      "Description": "別個のブール値を要素に持つリスト内で対応するインデックスを検索して、 シーケンスをフィルタします。\n\nList.FilterByBoolMask (list: var[]..[], mask: var[]..[]): var[]..[]"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# IN[0] : Revit要素（単体 or リスト） 例) Select Model Elements\r\n# IN[1] : パラメーター名（表示名 or BuiltInParameter名） 単体でもリストでもOK\r\n# OUT   : (grouped_elements, keys)\r\n#         grouped_elements: 指定パラメータ値の組み合わせごとの要素リスト（ソート済み）\r\n#         keys            : 上記グループのキー（パラメータ値タプル、ソート済み）\r\n\r\nimport clr\r\nimport System\r\n\r\n# Revit API\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import (\r\n    BuiltInParameter, StorageType, ElementId\r\n)\r\n\r\n# RevitServices\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# ---- 入力の正規化 ----\r\ndef to_list(x):\r\n    return x if isinstance(x, list) else [x]\r\n\r\n# DynamoのUnwrapElementはリストにもそのまま使えるが、保険で明示処理\r\ndef unwrap_any(x):\r\n    try:\r\n        return UnwrapElement(x)\r\n    except:\r\n        return x\r\n\r\nraw_elements = IN[0]\r\nelements = to_list(unwrap_any(raw_elements))\r\nparam_names = IN[1]\r\nparam_names = to_list(param_names)\r\n\r\n# ---- ユーティリティ ----\r\n\r\ndef try_get_bip(name):\r\n    \"\"\"\r\n    文字列から BuiltInParameter を取得（存在しなければ None）\r\n    例: \"DOOR_WIDTH\" -> BuiltInParameter.DOOR_WIDTH\r\n    \"\"\"\r\n    try:\r\n        return getattr(BuiltInParameter, name)\r\n    except AttributeError:\r\n        return None\r\n\r\ndef get_type_element(elem):\r\n    \"\"\"\r\n    要素のタイプ要素を返す（タイプ要素自身の場合は None のまま）\r\n    \"\"\"\r\n    try:\r\n        tid = elem.GetTypeId()\r\n        if isinstance(tid, ElementId) and tid.IntegerValue > 0:\r\n            return doc.GetElement(tid)\r\n    except:\r\n        pass\r\n    return None\r\n\r\ndef extract_value(param):\r\n    \"\"\"\r\n    Parameter から値を安全に取り出す\r\n    1) AsValueString（あれば）優先\r\n    2) 型に応じて値を返す\r\n    \"\"\"\r\n    if param is None:\r\n        return \"Param Not Found\"\r\n\r\n    # 表示用文字列（単位付き）を最優先\r\n    try:\r\n        s = param.AsValueString()\r\n        if s is not None:\r\n            return s\r\n    except:\r\n        # 一部の型/状況で例外になることがあるため無視\r\n        pass\r\n\r\n    st = param.StorageType\r\n    if st == StorageType.String:\r\n        sv = param.AsString()\r\n        return sv if sv is not None else \"Null\"\r\n    elif st == StorageType.Integer:\r\n        return param.AsInteger()\r\n    elif st == StorageType.Double:\r\n        # 内部単位のまま（必要ならここで単位変換を追加）\r\n        try:\r\n            return round(param.AsDouble(), 6)\r\n        except:\r\n            return \"Null\"\r\n    elif st == StorageType.ElementId:\r\n        try:\r\n            eid = param.AsElementId()\r\n            if eid and eid.IntegerValue > 0:\r\n                ref_el = doc.GetElement(eid)\r\n                # 参照先があれば名前、なければ数値ID\r\n                return getattr(ref_el, \"Name\", eid.IntegerValue)\r\n            return \"Null\"\r\n        except:\r\n            return \"Null\"\r\n    else:\r\n        return \"Null\"\r\n\r\ndef get_parameter_by_name_or_bip(elem, name_or_bip):\r\n    \"\"\"\r\n    取得順序：\r\n      1) BuiltInParameter名としてインスタンスから get_Parameter\r\n      2) BuiltInParameter名としてタイプから get_Parameter\r\n      3) 表示名としてインスタンスから LookupParameter\r\n      4) 表示名としてタイプから LookupParameter\r\n    見つからなければ \"Param Not Found\"\r\n    \"\"\"\r\n    if elem is None:\r\n        return \"Param Not Found\"\r\n\r\n    # まず BIP 名として試す\r\n    bip = try_get_bip(name_or_bip)\r\n\r\n    # 1) インスタンス + BIP\r\n    if bip is not None:\r\n        try:\r\n            p = elem.get_Parameter(bip)\r\n            if p:\r\n                return extract_value(p)\r\n        except:\r\n            pass\r\n\r\n    # タイプ要素\r\n    typ = get_type_element(elem)\r\n\r\n    # 2) タイプ + BIP\r\n    if bip is not None and typ is not None:\r\n        try:\r\n            p = typ.get_Parameter(bip)\r\n            if p:\r\n                return extract_value(p)\r\n        except:\r\n            pass\r\n\r\n    # 3) インスタンス + 表示名\r\n    try:\r\n        p = elem.LookupParameter(name_or_bip)\r\n        if p:\r\n            return extract_value(p)\r\n    except:\r\n        pass\r\n\r\n    # 4) タイプ + 表示名\r\n    if typ is not None:\r\n        try:\r\n            p = typ.LookupParameter(name_or_bip)\r\n            if p:\r\n                return extract_value(p)\r\n        except:\r\n            pass\r\n\r\n    return \"Param Not Found\"\r\n\r\n# ---- グルーピング ----\r\ngrouped_data = {}  # key(tuple(values)) -> [elements]\r\n\r\nfor e in elements:\r\n    # 入力が Revit API 要素でない場合に備え再度安全にアンラップ\r\n    elem = unwrap_any(e)\r\n    values = []\r\n    for pname in param_names:\r\n        v = get_parameter_by_name_or_bip(elem, pname)\r\n        values.append(v)\r\n    key = tuple(values)\r\n    grouped_data.setdefault(key, []).append(e)  # 元の（ラップされた）要素を返す\r\n\r\n# ---- ソート（キーで昇順） ----\r\ntry:\r\n    sorted_items = sorted(grouped_data.items(), key=lambda x: x[0])\r\nexcept TypeError:\r\n    # 型が混在する場合（数値と文字列など）は文字列化してソート\r\n    sorted_items = sorted(grouped_data.items(), key=lambda x: str(x[0]))\r\n\r\ngrouped_elements = []\r\nkeys = []\r\nfor k, grp in sorted_items:\r\n    grouped_elements.append(grp)\r\n    keys.append(k)\r\n\r\nOUT = grouped_elements, keys\r\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "7d930545bf4741338aef10045fd11213",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "9912d4b24ce2439c8433bbc55c04b934",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "6a04dd8af02141a58b771e618f494652",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "fa4cee89c49344e0860fa68fbfc420c0",
          "Name": "OUT",
          "Description": "Python スクリプトの結果",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "埋め込み Python スクリプトを実行します。"
    },
    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "Id": "2b02f7d6a986447da634e66b7df7e37b",
      "NodeType": "CodeBlockNode",
      "Inputs": [
        {
          "Id": "98819b70993942bf99ff0aa84da4798c",
          "Name": "x",
          "Description": "x",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "ec292b805b884874baadab838ae1cf33",
          "Name": "",
          "Description": "行 1 の式の値",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "DesignScript のコードを直接作成することができます。",
      "Code": "x[0];"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# -*- coding: utf-8 -*-\r\n# Revit 2024 / Dynamo CPython3 用\r\n# IN[0] : リスト内リスト構造のドア要素\r\n# IN[1] : 部屋パラメーター名（近接中心性）\r\n# IN[2] : 部屋パラメーター名（次数中心性）\r\n# IN[3] : ドアパラメーター名（取付場所_変数1）\r\n# OUT   : IN[0] と同じリスト構造で「取付場所（文字列）」を出力\r\n\r\nimport clr\r\n\r\n# Dynamo / Revit API\r\nclr.AddReference(\"RevitServices\")\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\nclr.AddReference(\"RevitAPI\")\r\nfrom Autodesk.Revit.DB import BuiltInParameter, ElementId\r\n\r\n# ---------- 入力 ----------\r\ndoors_in          = IN[0]\r\nparam_closeness   = IN[1]  # 部屋：近接中心性\r\nparam_degree      = IN[2]  # 部屋：次数中心性\r\nparam_attach_var  = IN[3]  # ドア：取付場所_変数1（整数）\r\n\r\n# 「入力用_取付場所」は式中で固定名として出てきているので、ここでは名前を固定します\r\nPARAM_MANUAL_NAME = \"入力用_取付場所\"\r\n\r\ndoc  = DocumentManager.Instance.CurrentDBDocument\r\nview = doc.ActiveView\r\n\r\n# ---------- フェーズ取得（ビュー優先、なければ最後のフェーズ） ----------\r\ndef get_phase_for_doors(document, active_view):\r\n    # 1. ビューのフェーズ\r\n    try:\r\n        p_phase = active_view.get_Parameter(BuiltInParameter.VIEW_PHASE)\r\n        if p_phase:\r\n            eid = p_phase.AsElementId()\r\n            if eid and eid.IntegerValue != ElementId.InvalidElementId.IntegerValue:\r\n                return document.GetElement(eid)\r\n    except:\r\n        pass\r\n\r\n    # 2. プロジェクト中の最後のフェーズ\r\n    try:\r\n        phases = list(document.Phases)\r\n        if phases:\r\n            return phases[-1]\r\n    except:\r\n        pass\r\n\r\n    return None\r\n\r\nphase = get_phase_for_doors(doc, view)\r\n\r\n# ---------- 入力の Unwrap ＋ リスト構造保持 ----------\r\ndef unwrap_recursive(obj):\r\n    \"\"\"リスト内リストの構造を保ったまま UnwrapElement する\"\"\"\r\n    from System import Array  # .NET 配列対策\r\n    if isinstance(obj, (list, tuple)) or isinstance(obj, Array):\r\n        return [unwrap_recursive(o) for o in obj]\r\n    else:\r\n        try:\r\n            return UnwrapElement(obj)\r\n        except:\r\n            return obj\r\n\r\ndoors_tree = unwrap_recursive(doors_in)\r\n\r\n# ---------- Room / パラメーター取得系 ----------\r\n\r\ndef get_from_room(door, ph):\r\n    \"\"\"ドアの『部屋から』を返す。部屋がなければ None。\"\"\"\r\n    if door is None or ph is None:\r\n        return None\r\n    try:\r\n        return door.get_FromRoom(ph)\r\n    except:\r\n        return None\r\n\r\ndef get_to_room(door, ph):\r\n    \"\"\"ドアの『部屋へ』を返す。部屋がなければ None。\"\"\"\r\n    if door is None or ph is None:\r\n        return None\r\n    try:\r\n        return door.get_ToRoom(ph)\r\n    except:\r\n        return None\r\n\r\ndef get_room_param_double(room, param_name):\r\n    \"\"\"部屋の数値パラメーター（Double）を取得。なければ None。\"\"\"\r\n    if room is None or not param_name:\r\n        return None\r\n    p = room.LookupParameter(param_name)\r\n    if p is None:\r\n        return None\r\n    try:\r\n        # 数値パラメーター想定\r\n        return p.AsDouble()\r\n    except:\r\n        # もし文字列で入っている場合は、float 変換を試みる\r\n        try:\r\n            s = p.AsString()\r\n            if s is None:\r\n                return None\r\n            return float(s)\r\n        except:\r\n            return None\r\n\r\ndef get_room_name(room):\r\n    \"\"\"部屋名を取得。取れなければ '-'\"\"\"\r\n    if room is None:\r\n        return \"-\"\r\n    try:\r\n        # Room.Name プロパティ\r\n        name = room.Name\r\n        if name:\r\n            return name\r\n    except:\r\n        pass\r\n    try:\r\n        p = room.get_Parameter(BuiltInParameter.ROOM_NAME)\r\n        if p:\r\n            s = p.AsString()\r\n            if s:\r\n                return s\r\n    except:\r\n        pass\r\n    return \"-\"\r\n\r\ndef get_door_param_int(door, param_name):\r\n    \"\"\"ドアの整数パラメーター（取付場所_変数1）を取得。なければ 0 とする。\"\"\"\r\n    if door is None or not param_name:\r\n        return 0\r\n    p = door.LookupParameter(param_name)\r\n    if p is None:\r\n        return 0\r\n    try:\r\n        return int(p.AsInteger())\r\n    except:\r\n        # Double や String の場合も一応対応\r\n        try:\r\n            return int(p.AsDouble())\r\n        except:\r\n            try:\r\n                s = p.AsString()\r\n                return int(s)\r\n            except:\r\n                return 0\r\n\r\ndef get_door_param_string(door, param_name):\r\n    \"\"\"ドアの文字列パラメーター（入力用_取付場所）を取得。なければ '-'\"\"\"\r\n    if door is None or not param_name:\r\n        return \"-\"\r\n    p = door.LookupParameter(param_name)\r\n    if p is None:\r\n        return \"-\"\r\n    try:\r\n        s = p.AsString()\r\n        if s is None or s == \"\":\r\n            return \"-\"\r\n        return s\r\n    except:\r\n        return \"-\"\r\n\r\n# 比較用の小さな許容誤差（近接中心性・次数中心性用）\r\nEPS = 1e-9\r\n\r\ndef is_less(a, b):\r\n    \"\"\"a < b を安全に判定（None が混ざったら False）\"\"\"\r\n    if a is None or b is None:\r\n        return False\r\n    return a < b - EPS\r\n\r\ndef is_equal(a, b):\r\n    \"\"\"a == b を安全に判定（None が混ざったら False）\"\"\"\r\n    if a is None or b is None:\r\n        return False\r\n    return abs(a - b) <= EPS\r\n\r\n# ---------- 1つのドアから「取付場所の名前」を決めるロジック ----------\r\ndef decide_location_name_for_door(door):\r\n    \"\"\"\r\n    集計表の式と同じロジックで、取付場所となる部屋名などを返す。\r\n    \"\"\"\r\n\r\n    # 取付場所_変数1（整数）\r\n    v = get_door_param_int(door, param_attach_var)\r\n\r\n    # From / To の部屋\r\n    from_room = get_from_room(door, phase)\r\n    to_room   = get_to_room(door, phase)\r\n\r\n    # 近接中心性\r\n    cf_from = get_room_param_double(from_room, param_closeness)\r\n    cf_to   = get_room_param_double(to_room,   param_closeness)\r\n\r\n    # 次数中心性\r\n    cd_from = get_room_param_double(from_room, param_degree)\r\n    cd_to   = get_room_param_double(to_room,   param_degree)\r\n\r\n    # 部屋名\r\n    name_from = get_room_name(from_room)\r\n    name_to   = get_room_name(to_room)\r\n\r\n    # -------------------------------\r\n    # 集計表の if 式をそのまま Python に対応させた条件\r\n    # -------------------------------\r\n\r\n    # if(and(取付場所_変数1 = 0, 部屋から: 近接中心性 < 部屋へ: 近接中心性), 部屋から: 名前, ...\r\n    if (v == 0) and is_less(cf_from, cf_to):\r\n        return name_from\r\n\r\n    # if(and(取付場所_変数1 = 0, 部屋から: 近接中心性 > 部屋へ: 近接中心性), 部屋へ: 名前, ...\r\n    if (v == 0) and is_less(cf_to, cf_from):\r\n        return name_to\r\n\r\n    # if(and(取付場所_変数1 = 0,\r\n    #        部屋から: 近接中心性 = 部屋へ: 近接中心性,\r\n    #        部屋から: 次数中心性 < 部屋へ: 次数中心性), 部屋から: 名前, ...\r\n    if (v == 0) and is_equal(cf_from, cf_to) and is_less(cd_from, cd_to):\r\n        return name_from\r\n\r\n    # if(and(取付場所_変数1 = 0,\r\n    #        部屋から: 近接中心性 = 部屋へ: 近接中心性,\r\n    #        部屋から: 次数中心性 > 部屋へ: 次数中心性), 部屋へ: 名前, ...\r\n    if (v == 0) and is_equal(cf_from, cf_to) and is_less(cd_to, cd_from):\r\n        return name_to\r\n\r\n    # ★ 追加された条件 ★\r\n    # if(and(取付場所_変数1 = 0,\r\n    #        部屋から: 近接中心性 = 部屋へ: 近接中心性,\r\n    #        部屋から: 次数中心性 = 部屋へ: 次数中心性), 部屋から: 名前, ...\r\n    if (v == 0) and is_equal(cf_from, cf_to) and is_equal(cd_from, cd_to):\r\n        return name_from\r\n\r\n    # if(取付場所_変数1 = 1, 入力用_取付場所, ...\r\n    if v == 1:\r\n        return get_door_param_string(door, PARAM_MANUAL_NAME)\r\n\r\n    # if(取付場所_変数1 = 2, 部屋から: 名前, ...\r\n    if v == 2:\r\n        return name_from\r\n\r\n    # if(取付場所_変数1 = 3, 部屋へ: 名前, ...\r\n    if v == 3:\r\n        return name_to\r\n\r\n    # 最後の else \"-\"\r\n    return \"-\"\r\n\r\n# ---------- リスト構造を保ったまま処理 ----------\r\ndef process_tree(obj):\r\n    \"\"\"doors_tree と同じ構造で、各ドアを取付場所名に変換する\"\"\"\r\n    if isinstance(obj, list):\r\n        return [process_tree(o) for o in obj]\r\n    else:\r\n        # ドア要素を想定\r\n        return decide_location_name_for_door(obj)\r\n\r\n# 今回は読み取りのみなのでトランザクション不要\r\nOUT = process_tree(doors_tree)\r\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "5ed05c46097f4fb6a4ab134970a82e25",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "2fb6eaa90e214cd6821c8fc1c8d4e064",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "715d6e6952fb4c4f90ae2ffbf97c6322",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "91458faeafb443728121b323eaa394ea",
          "Name": "IN[2]",
          "Description": "Input #2",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "c072643db7264a7d9cad1e681c6e06f7",
          "Name": "IN[3]",
          "Description": "Input #3",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "50ce85df17714961b55463fd6b5ea72e",
          "Name": "OUT",
          "Description": "Python スクリプトの結果",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "埋め込み Python スクリプトを実行します。"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nimport System\r\n\r\n# Revit APIのインポート\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\n\r\n# IN[0]: 要素のリスト（リスト内リスト）\r\n# IN[1]: 既に取得済みの部屋名のリスト（リスト内リスト、IN[0]と同じ構造）\r\nelements_tree = UnwrapElement(IN[0])\r\nnames_tree    = IN[1]\r\n\r\nlist1 = []\r\n\r\n# IN[0] と IN[1] の構造が同じである前提で、二重ループ＋zipで対応付け\r\nfor elem_row, name_row in zip(elements_tree, names_tree):\r\n    row_result = []\r\n    for elem, name in zip(elem_row, name_row):\r\n        dic = {}\r\n        dic['ID'] = elem.Id.Value\r\n        dic['名前'] = name  # ここで LookupParameter は使わず、IN[1] の値をそのまま採用\r\n        row_result.append(dic)\r\n    list1.append(row_result)\r\n\r\nOUT = list1\r\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "e5d5910868f946468c3bd6a687f4d0c8",
      "NodeType": "PythonScriptNode",
      "Inputs": [
