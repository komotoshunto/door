    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# -*- coding: utf-8 -*-\r\n# Revit 2024 / Dynamo CPython3 用\r\n# IN[0] : リスト内リスト構造のドア要素\r\n# IN[1] : 部屋パラメーター名（近接中心性）\r\n# IN[2] : 部屋パラメーター名（次数中心性）\r\n# IN[3] : ドアパラメーター名（取付場所_変数1）\r\n# OUT   : IN[0] と同じリスト構造で「取付場所（文字列）」を出力\r\n\r\nimport clr\r\n\r\n# Dynamo / Revit API\r\nclr.AddReference(\"RevitServices\")\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\nclr.AddReference(\"RevitAPI\")\r\nfrom Autodesk.Revit.DB import BuiltInParameter, ElementId\r\n\r\n# ---------- 入力 ----------\r\ndoors_in          = IN[0]\r\nparam_closeness   = IN[1]  # 部屋：近接中心性\r\nparam_degree      = IN[2]  # 部屋：次数中心性\r\nparam_attach_var  = IN[3]  # ドア：取付場所_変数1（整数）\r\n\r\n# 「入力用_取付場所」は式中で固定名として出てきているので、ここでは名前を固定します\r\nPARAM_MANUAL_NAME = \"入力用_取付場所\"\r\n\r\ndoc  = DocumentManager.Instance.CurrentDBDocument\r\nview = doc.ActiveView\r\n\r\n# ---------- フェーズ取得（ビュー優先、なければ最後のフェーズ） ----------\r\ndef get_phase_for_doors(document, active_view):\r\n    # 1. ビューのフェーズ\r\n    try:\r\n        p_phase = active_view.get_Parameter(BuiltInParameter.VIEW_PHASE)\r\n        if p_phase:\r\n            eid = p_phase.AsElementId()\r\n            if eid and eid.IntegerValue != ElementId.InvalidElementId.IntegerValue:\r\n                return document.GetElement(eid)\r\n    except:\r\n        pass\r\n\r\n    # 2. プロジェクト中の最後のフェーズ\r\n    try:\r\n        phases = list(document.Phases)\r\n        if phases:\r\n            return phases[-1]\r\n    except:\r\n        pass\r\n\r\n    return None\r\n\r\nphase = get_phase_for_doors(doc, view)\r\n\r\n# ---------- 入力の Unwrap ＋ リスト構造保持 ----------\r\ndef unwrap_recursive(obj):\r\n    \"\"\"リスト内リストの構造を保ったまま UnwrapElement する\"\"\"\r\n    from System import Array  # .NET 配列対策\r\n    if isinstance(obj, (list, tuple)) or isinstance(obj, Array):\r\n        return [unwrap_recursive(o) for o in obj]\r\n    else:\r\n        try:\r\n            return UnwrapElement(obj)\r\n        except:\r\n            return obj\r\n\r\ndoors_tree = unwrap_recursive(doors_in)\r\n\r\n# ---------- Room / パラメーター取得系 ----------\r\n\r\ndef get_from_room(door, ph):\r\n    \"\"\"ドアの『部屋から』を返す。部屋がなければ None。\"\"\"\r\n    if door is None or ph is None:\r\n        return None\r\n    try:\r\n        return door.get_FromRoom(ph)\r\n    except:\r\n        return None\r\n\r\ndef get_to_room(door, ph):\r\n    \"\"\"ドアの『部屋へ』を返す。部屋がなければ None。\"\"\"\r\n    if door is None or ph is None:\r\n        return None\r\n    try:\r\n        return door.get_ToRoom(ph)\r\n    except:\r\n        return None\r\n\r\ndef get_room_param_double(room, param_name):\r\n    \"\"\"部屋の数値パラメーター（Double）を取得。なければ None。\"\"\"\r\n    if room is None or not param_name:\r\n        return None\r\n    p = room.LookupParameter(param_name)\r\n    if p is None:\r\n        return None\r\n    try:\r\n        # 数値パラメーター想定\r\n        return p.AsDouble()\r\n    except:\r\n        # もし文字列で入っている場合は、float 変換を試みる\r\n        try:\r\n            s = p.AsString()\r\n            if s is None:\r\n                return None\r\n            return float(s)\r\n        except:\r\n            return None\r\n\r\ndef get_room_name(room):\r\n    \"\"\"部屋名を取得。取れなければ '-'\"\"\"\r\n    if room is None:\r\n        return \"-\"\r\n    try:\r\n        # Room.Name プロパティ\r\n        name = room.Name\r\n        if name:\r\n            return name\r\n    except:\r\n        pass\r\n    try:\r\n        p = room.get_Parameter(BuiltInParameter.ROOM_NAME)\r\n        if p:\r\n            s = p.AsString()\r\n            if s:\r\n                return s\r\n    except:\r\n        pass\r\n    return \"-\"\r\n\r\ndef get_door_param_int(door, param_name):\r\n    \"\"\"ドアの整数パラメーター（取付場所_変数1）を取得。なければ 0 とする。\"\"\"\r\n    if door is None or not param_name:\r\n        return 0\r\n    p = door.LookupParameter(param_name)\r\n    if p is None:\r\n        return 0\r\n    try:\r\n        return int(p.AsInteger())\r\n    except:\r\n        # Double や String の場合も一応対応\r\n        try:\r\n            return int(p.AsDouble())\r\n        except:\r\n            try:\r\n                s = p.AsString()\r\n                return int(s)\r\n            except:\r\n                return 0\r\n\r\ndef get_door_param_string(door, param_name):\r\n    \"\"\"ドアの文字列パラメーター（入力用_取付場所）を取得。なければ '-'\"\"\"\r\n    if door is None or not param_name:\r\n        return \"-\"\r\n    p = door.LookupParameter(param_name)\r\n    if p is None:\r\n        return \"-\"\r\n    try:\r\n        s = p.AsString()\r\n        if s is None or s == \"\":\r\n            return \"-\"\r\n        return s\r\n    except:\r\n        return \"-\"\r\n\r\n# 比較用の小さな許容誤差（近接中心性・次数中心性用）\r\nEPS = 1e-9\r\n\r\ndef is_less(a, b):\r\n    \"\"\"a < b を安全に判定（None が混ざったら False）\"\"\"\r\n    if a is None or b is None:\r\n        return False\r\n    return a < b - EPS\r\n\r\ndef is_equal(a, b):\r\n    \"\"\"a == b を安全に判定（None が混ざったら False）\"\"\"\r\n    if a is None or b is None:\r\n        return False\r\n    return abs(a - b) <= EPS\r\n\r\n# ---------- 1つのドアから「取付場所の名前」を決めるロジック ----------\r\ndef decide_location_name_for_door(door):\r\n    \"\"\"\r\n    集計表の式と同じロジックで、取付場所となる部屋名などを返す。\r\n    \"\"\"\r\n\r\n    # 取付場所_変数1（整数）\r\n    v = get_door_param_int(door, param_attach_var)\r\n\r\n    # From / To の部屋\r\n    from_room = get_from_room(door, phase)\r\n    to_room   = get_to_room(door, phase)\r\n\r\n    # 近接中心性\r\n    cf_from = get_room_param_double(from_room, param_closeness)\r\n    cf_to   = get_room_param_double(to_room,   param_closeness)\r\n\r\n    # 次数中心性\r\n    cd_from = get_room_param_double(from_room, param_degree)\r\n    cd_to   = get_room_param_double(to_room,   param_degree)\r\n\r\n    # 部屋名\r\n    name_from = get_room_name(from_room)\r\n    name_to   = get_room_name(to_room)\r\n\r\n    # -------------------------------\r\n    # 集計表の if 式をそのまま Python に対応させた条件\r\n    # -------------------------------\r\n\r\n    # if(and(取付場所_変数1 = 0, 部屋から: 近接中心性 < 部屋へ: 近接中心性), 部屋から: 名前, ...\r\n    if (v == 0) and is_less(cf_from, cf_to):\r\n        return name_from\r\n\r\n    # if(and(取付場所_変数1 = 0, 部屋から: 近接中心性 > 部屋へ: 近接中心性), 部屋へ: 名前, ...\r\n    if (v == 0) and is_less(cf_to, cf_from):\r\n        return name_to\r\n\r\n    # if(and(取付場所_変数1 = 0,\r\n    #        部屋から: 近接中心性 = 部屋へ: 近接中心性,\r\n    #        部屋から: 次数中心性 < 部屋へ: 次数中心性), 部屋から: 名前, ...\r\n    if (v == 0) and is_equal(cf_from, cf_to) and is_less(cd_from, cd_to):\r\n        return name_from\r\n\r\n    # if(and(取付場所_変数1 = 0,\r\n    #        部屋から: 近接中心性 = 部屋へ: 近接中心性,\r\n    #        部屋から: 次数中心性 > 部屋へ: 次数中心性), 部屋へ: 名前, ...\r\n    if (v == 0) and is_equal(cf_from, cf_to) and is_less(cd_to, cd_from):\r\n        return name_to\r\n\r\n    # ★ 追加された条件 ★\r\n    # if(and(取付場所_変数1 = 0,\r\n    #        部屋から: 近接中心性 = 部屋へ: 近接中心性,\r\n    #        部屋から: 次数中心性 = 部屋へ: 次数中心性), 部屋から: 名前, ...\r\n    if (v == 0) and is_equal(cf_from, cf_to) and is_equal(cd_from, cd_to):\r\n        return name_from\r\n\r\n    # if(取付場所_変数1 = 1, 入力用_取付場所, ...\r\n    if v == 1:\r\n        return get_door_param_string(door, PARAM_MANUAL_NAME)\r\n\r\n    # if(取付場所_変数1 = 2, 部屋から: 名前, ...\r\n    if v == 2:\r\n        return name_from\r\n\r\n    # if(取付場所_変数1 = 3, 部屋へ: 名前, ...\r\n    if v == 3:\r\n        return name_to\r\n\r\n    # 最後の else \"-\"\r\n    return \"-\"\r\n\r\n# ---------- リスト構造を保ったまま処理 ----------\r\ndef process_tree(obj):\r\n    \"\"\"doors_tree と同じ構造で、各ドアを取付場所名に変換する\"\"\"\r\n    if isinstance(obj, list):\r\n        return [process_tree(o) for o in obj]\r\n    else:\r\n        # ドア要素を想定\r\n        return decide_location_name_for_door(obj)\r\n\r\n# 今回は読み取りのみなのでトランザクション不要\r\nOUT = process_tree(doors_tree)\r\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "cac2918ad1244a2196bd6ca848563941",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "e2325734c5d8428e8407b21a9d05783d",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "108a98255e9e434abdbbd1767123c55b",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "e7b1be826f2b4b4c9664a26ab6fb6249",
          "Name": "IN[2]",
          "Description": "Input #2",
          "UsingDefaultValue": false,
          "Level": 2,
