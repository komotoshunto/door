          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "ff119e87aa20416ca9adadac35bc9982",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
