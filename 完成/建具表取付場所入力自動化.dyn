      "Inputs": [],
      "Outputs": [
        {
          "Id": "41d7db8195d04e1c9bad2feb55a7ab6b",
          "Name": "Category",
          "Description": "選択した カテゴリ。",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "すべての組み込みカテゴリ。"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# -*- coding: utf-8 -*-\r\n# Revit 2024 / Dynamo CPython3 用\r\n# IN[0] : ドア要素（単体 または リスト）\r\n# IN[1] : 整数パラメーター名（例: \"取付場所_変数\"）\r\n# OUT   : 各ドアに設定した値のリスト\r\n\r\nimport clr\r\n\r\n# Revit / Dynamo API 参照\r\nclr.AddReference(\"RevitServices\")\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\nclr.AddReference(\"RevitAPI\")\r\nfrom Autodesk.Revit.DB import BuiltInParameter, ElementId\r\n\r\ndoc  = DocumentManager.Instance.CurrentDBDocument\r\nview = doc.ActiveView\r\n\r\n# ---------- フェーズ取得（ビュー優先、なければ最後のフェーズ） ----------\r\ndef get_phase_for_doors(document, active_view):\r\n    try:\r\n        p_phase = active_view.get_Parameter(BuiltInParameter.VIEW_PHASE)\r\n        if p_phase:\r\n            eid = p_phase.AsElementId()\r\n            if eid and eid.IntegerValue != ElementId.InvalidElementId.IntegerValue:\r\n                return document.GetElement(eid)\r\n    except:\r\n        pass\r\n\r\n    try:\r\n        phases = list(document.Phases)\r\n        if phases:\r\n            return phases[-1]\r\n    except:\r\n        pass\r\n\r\n    return None\r\n\r\nphase = get_phase_for_doors(doc, view)\r\n\r\n# ---------- 入力正規化 ----------\r\ndoors_in = IN[0]\r\nparam_name = IN[1]\r\n\r\nif not param_name:\r\n    raise Exception(\"IN[1] に整数パラメーター名（例: '取付場所_変数'）を入力してください。\")\r\n\r\nif doors_in is None:\r\n    doors = []\r\nelif isinstance(doors_in, (list, tuple)):\r\n    doors = list(UnwrapElement(doors_in))\r\nelse:\r\n    doors = [UnwrapElement(doors_in)]\r\n\r\n# ---------- FromRoom / ToRoom ----------\r\ndef get_from_room(door, ph):\r\n    if door is None or ph is None:\r\n        return None\r\n    try:\r\n        return door.get_FromRoom(ph)\r\n    except:\r\n        return None\r\n\r\ndef get_to_room(door, ph):\r\n    if door is None or ph is None:\r\n        return None\r\n    try:\r\n        return door.get_ToRoom(ph)\r\n    except:\r\n        return None\r\n\r\n# ---------- メイン処理 ----------\r\nvalues_set = []\r\n\r\nif doors:\r\n    TransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\n    for d in doors:\r\n        if d is None:\r\n            values_set.append(None)\r\n            continue\r\n\r\n        from_room = get_from_room(d, phase)\r\n        to_room   = get_to_room(d, phase)\r\n\r\n        has_from = (from_room is not None)\r\n        has_to   = (to_room   is not None)\r\n\r\n        # 基本値 0\r\n        value = 0\r\n        # 「部屋から」あり & 「部屋へ」なし → 2\r\n        if has_from and (not has_to):\r\n            value = 2\r\n        # 「部屋へ」あり & 「部屋から」なし → 3\r\n        elif has_to and (not has_from):\r\n            value = 3\r\n\r\n        # パラメーター書き込み\r\n        p = d.LookupParameter(param_name)\r\n        if p and (not p.IsReadOnly):\r\n            try:\r\n                p.Set(int(value))\r\n            except:\r\n                pass\r\n\r\n        values_set.append(value)\r\n\r\n    TransactionManager.Instance.TransactionTaskDone()\r\n\r\nOUT = values_set\r\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "63b04e8c94ca4befad619bee56cff0f4",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "0d270f3c906449df999574e7d225eaa3",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "590a91aed5b34b58ad6516a21aa5c8d7",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
