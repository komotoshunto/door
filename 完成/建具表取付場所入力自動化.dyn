    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n\r\n# Revit API を読み込み\r\nclr.AddReference(\"RevitAPI\")\r\nfrom Autodesk.Revit.DB import FamilyInstance\r\n\r\n# Dynamo から渡ってきた入力（Revit要素のリスト）\r\nelements = UnwrapElement(IN[0])\r\n\r\nis_nested_list = []   # True/False（ネストかどうか）\r\nhost_list = []        # ネストされている場合のホストファミリ（なければ None）\r\n\r\nfor e in elements:\r\n    # FamilyInstance かどうかチェック\r\n    fi = e if isinstance(e, FamilyInstance) else None\r\n    \r\n    if fi is None:\r\n        # そもそもファミリインスタンスではない場合\r\n        is_nested_list.append(False)\r\n        host_list.append(None)\r\n    else:\r\n        # SuperComponent が None → トップレベル\r\n        # SuperComponent がある → 何かの中にネストされている\r\n        super_comp = fi.SuperComponent\r\n        \r\n        if super_comp is None:\r\n            is_nested_list.append(False)\r\n            host_list.append(None)\r\n        else:\r\n            is_nested_list.append(True)\r\n            host_list.append(super_comp)\r\n\r\n# OUT[0] : True/False（ネストかどうか）\r\n# OUT[1] : ホストファミリ（ネストでない場合は None）\r\nOUT = (is_nested_list, host_list)\r\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "5d53e76c0c7742a8b60e3246880c99dd",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "9d97bd4671d9479e9323c4c67d02cc75",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "0cbb8f7513cf4533ae8983873d62d912",
          "Name": "OUT",
          "Description": "Python スクリプトの結果",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "埋め込み Python スクリプトを実行します。"
    },
